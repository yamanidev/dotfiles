alias pn=pnpm

# Git
alias s="git status"
alias c="git clone"

# Utilities
alias h="history | grep "

# Claude Code
alias cc-work='CLAUDE_CONFIG_DIR=$HOME/.claude-work claude'
alias cc-personal='CLAUDE_CONFIG_DIR=$HOME/.claude-personal claude'

# OS-specific aliases
[[ -r "$ZDOTDIR/os.aliases" ]] && source "$ZDOTDIR/os.aliases"
